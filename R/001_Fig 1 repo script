#####  create a list of site level plots, bars filled by exposure


plot_list <- top6_all_years_complete %>%
  #filter(Taxon != "Turf.algae") %>%
  group_split(Site) %>%
  set_names(site_names) %>%
  purrr::map(~ {
    
    # determine 2011 ranking for this site
    taxon_order <- .x %>%
      dplyr::filter(Year == 2011) %>%
      dplyr::arrange(dplyr::desc(mean)) %>%
      dplyr::pull(Taxon)
    
    # apply ordering
    .x <- .x %>%
      dplyr::mutate(Taxon = factor(Taxon, levels = taxon_order))
    
    # ---- lookup exposure colour for this site ----
    this_site <- unique(.x$Site)
    
    axis_col <- site_exposure %>%
      dplyr::filter(Site == this_site) %>%
      dplyr::pull(Exposure_col) %>%
      .[1]
    
    # ---- make a YEAR gradient that ends in the exposure colour ----
    years <- sort(unique(.x$Year))
    .x <- .x %>%
      dplyr::mutate(Year = factor(Year, levels = years))
    
    year_cols <- setNames(
      grDevices::colorRampPalette(c("grey92", axis_col))(length(years)),
      as.character(years)
    )
    
    ggplot(.x, aes(x = Taxon, y = mean, fill = Year)) +
      geom_col(
        position = position_dodge(width = 0.9),
        width = 0.8,
        show.legend = FALSE,
      ) +
      geom_errorbar(
        aes(ymin = mean - se, ymax = mean + se),
        position = position_dodge(width = 0.9),
        width = 0,
        linewidth = 0.1
      ) +
      scale_x_discrete(drop = FALSE,
                       labels = taxon_labels) +
      scale_fill_manual(values = year_cols) +
      labs(
        title = unique(.x$Site),
        x = NULL,
        y = "Cover (%)",
        fill = "Year"
      ) +
      theme_classic() +
      theme(
        axis.text.x = element_text(angle = 45, hjust = 1, size = 8),
        axis.title.y = element_text(size = 8),# colour = axis_col),
        #axis.title.x = element_text(colour = axis_col),
        plot.margin = margin(0.2, 0.2, 0.2, 0.2),
        panel.background = element_rect(fill = NA),
        plot.title = element_text(
          size = 8, hjust = 0,
          margin = margin(b = 0)#,
          #colour = axis_col
        ),
        plot.background = element_rect(fill = NA, colour = NA),
        panel.border = element_blank(),
        # axis.line  = element_line(colour = axis_col),
        # axis.ticks = element_line(colour = axis_col),
        axis.text.y  = element_text(size = 8),
        legend.position = "none"
      )
  })


