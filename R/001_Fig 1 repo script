#########################################
#### function for replacing full stops, and italicising genera

taxon_labels <- function(x) {
  
  # Replace full stops and underscores with spaces
  labels <- gsub("[._]+", " ", x)
  
  # Broad benthic categories that should NOT be italicised
  broad_taxa <- c(
    "Total HCC", "Total algae", "Turf algae",
    "Coralline algae", "Soft coral", "Macroalgae",
    "Rubble", "sand", "Sponge", "Coral genera","Fire coral"
  )
  
  # Italicise coral genera, but not broad categories
  italic <- !labels %in% broad_taxa
  
  # Return plotmath expressions
  parse(text = ifelse(
    italic,
    paste0("italic(", shQuote(labels), ")"),
    shQuote(labels)
  ))
}

